---
layout: false
permalink: /
---
{% extends "base.njk" %}

{% block preload %}
  <link rel="preload" as="image" href="/assets/img/hero-poster-1600.jpg" fetchpriority="high">
{% endblock %}

{% block schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "{{ site.url }}/#organization",
      "name": {{ site.name | json | safe }},
      "alternateName": {{ site.legalName | json | safe }},
      "url": "{{ site.url }}/",
      "logo": "{{ site.url }}/assets/icon-512.png",
      "image": "{{ site.url }}{{ site.ogImage }}",
      "email": "{{ site.email }}",
      "slogan": {{ site.tagline | json | safe }},
      "description": {{ site.about | json | safe }},
      "knowsAbout": ["Film production", "Commercial videography", "Documentary film", "Photography", "Brand campaigns", "Television production"],
      "sameAs": [{% for s in site.social %}"{{ s.url }}"{% if not loop.last %}, {% endif %}{% endfor %}]
    },
    {
      "@type": "WebSite",
      "@id": "{{ site.url }}/#website",
      "url": "{{ site.url }}/",
      "name": {{ site.name | json | safe }},
      "description": {{ site.description | json | safe }},
      "inLanguage": "{{ site.lang }}",
      "publisher": { "@id": "{{ site.url }}/#organization" }
    },
    {
      "@type": "ItemList",
      "@id": "{{ site.url }}/#work",
      "name": "Selected work",
      "itemListElement": [
        {%- for p in projects %}
        {
          "@type": "ListItem",
          "position": {{ loop.index }},
          "url": "{{ site.url }}/#{{ p.slug }}",
          "item": {
            "@type": "CreativeWork",
            "name": {{ p.title | json | safe }},
            "genre": {{ p.discipline | json | safe }},
            "description": {{ p.description | json | safe }},
            "image": "{{ site.url }}/assets/img/{{ p.slug }}-02-1600.jpg",
            "creator": { "@id": "{{ site.url }}/#organization" }
          }
        }{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]
    }
  ]
}
</script>
{% endblock %}

{% block content %}
<div class="grain" aria-hidden="true"></div>
<div class="cursor" aria-hidden="true"><span class="cursor__ring"><span class="cursor__label"></span></span></div>

{# Letterbox intro — plays once per session, CSS-driven so it can never get stuck #}
<div class="intro" aria-hidden="true">
  <div class="intro__bar intro__bar--top"></div>
  <div class="intro__bar intro__bar--bot"></div>
  <div class="intro__slate">
    <img src="/assets/brand/mark.svg" alt="" width="72" height="72">
    <span class="mono">Minds fused <b>×</b> stories born</span>
  </div>
</div>

<header class="nav" data-nav>
  <a class="nav__brand" href="#top" aria-label="{{ site.name }} — back to top">
    <img src="/assets/brand/wordmark.png" alt="{{ site.name }}" width="512" height="153">
  </a>
  <nav class="nav__links" aria-label="Primary">
    <a href="#work" data-link>Work</a>
    <a href="#words" data-link>Words</a>
    <a href="#contact" data-link>Contact</a>
  </nav>
  <a class="nav__cta" href="mailto:{{ site.email }}"><span>Email us</span></a>
  <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
    <span class="nav__toggle-line"></span><span class="nav__toggle-line"></span>
    <span class="sr-only">Menu</span>
  </button>
</header>

<div class="menu" id="menu" data-menu hidden>
  <nav class="menu__links" aria-label="Mobile">
    <a href="#work"><span class="mono">01</span>Work</a>
    <a href="#words"><span class="mono">02</span>Words</a>
    <a href="#contact"><span class="mono">03</span>Contact</a>
  </nav>
  <div class="menu__foot mono">
    <a href="mailto:{{ site.email }}">{{ site.email }}</a>
    {% for s in site.social %}<a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.name }}</a>{% endfor %}
  </div>
</div>

<main id="main">

  {# ───────────── HERO ───────────── #}
  <section class="hero" id="top" data-hero>
    <div class="hero__stage">
      <div class="hero__media">
        <video class="hero__video" autoplay muted loop playsinline preload="auto"
               poster="/assets/img/hero-poster-1600.jpg" data-hero-video>
          <source src="/assets/video/hero-reel-sm.mp4" type="video/mp4" media="(max-width: 760px)">
          <source src="/assets/video/hero-reel.mp4" type="video/mp4">
        </video>
        <div class="hero__shade"></div>
      </div>

      <div class="hud" aria-hidden="true">
        <span class="hud__corner hud__corner--tl"></span><span class="hud__corner hud__corner--tr"></span>
        <span class="hud__corner hud__corner--bl"></span><span class="hud__corner hud__corner--br"></span>
        <span class="hud__meta hud__meta--tl mono"><i class="rec"></i>Rec <span data-tc>00:00:00:00</span></span>
        <span class="hud__meta hud__meta--tr mono">Showreel <b>/</b> Mind Fusion</span>
        <span class="hud__cross"></span>
      </div>

      <h1 class="hero__title">
        <span class="sr-only">{{ site.name }} — film and photography production. </span>
        <span class="hero__line hero__line--1"><span class="mask"><span>Minds fused</span></span></span>
        <span class="hero__x" aria-hidden="true"><span>×</span></span>
        <span class="hero__line hero__line--2"><span class="mask"><span>Stories born.</span></span></span>
      </h1>

      <div class="hero__foot">
        <p class="mono">{{ site.motto }}</p>
        <a class="hero__cue mono" href="#work" data-link>
          <span>Selected work</span><span class="hero__cue-count">01 — {{ projects.length | pad }}</span>
          <span class="hero__cue-line" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </section>

  {# ───────────── ABOUT / MANIFESTO ───────────── #}
  <section class="about" id="about" aria-labelledby="about-title">
    <div class="about__side">
      <span class="label mono">(About)</span>
      <h2 class="about__title" id="about-title" data-reveal>
        <span class="serif">Disrupting film,</span>
        <span class="serif"><em>uniting minds.</em></span>
      </h2>
    </div>
    <p class="about__text" data-scrub>{{ site.about }}</p>
    <ul class="about__crafts mono" aria-label="What we make" data-reveal>
      <li>Film</li><li>Photography</li><li>Commercial</li><li>Documentary</li><li>Television</li><li>Social</li>
    </ul>
  </section>

  {# ───────────── WORK HEADING ───────────── #}
  <section class="work" id="work" aria-labelledby="work-title">
    <header class="section-head">
      <span class="label mono">(Selected work)</span>
      <h2 class="section-head__title" id="work-title" data-reveal>
        <span class="mask"><span>Selected</span></span>
        <span class="mask"><span><em class="serif">work</em></span></span>
      </h2>
      <span class="label mono section-head__count">{{ projects.length | pad }} titles</span>
    </header>

        {# Project selector (ref 03): hover a column to wipe its frame up; click to open it
       full-width and travel straight into that project's chapter #}
    <div class="picker" data-picker style="--n: {{ projects.length }}">
      <div class="picker__layers" aria-hidden="true">
        {% for p in projects %}
        <div class="picker__layer" data-layer style="--img: url('/assets/img/{{ p.slug }}-02-1600.jpg')">
          {% for q in projects %}<span class="picker__slice" style="--c: {{ loop.index0 }}"></span>{% endfor %}
        </div>
        {% endfor %}
        <div class="picker__shade"></div>
      </div>

      <ol class="picker__cols">
        {% for p in projects %}
        <li class="picker__col">
          <a class="picker__btn" href="#{{ p.slug }}" data-pick data-cursor="Open">
            <span class="picker__no mono">{{ loop.index | pad }}</span>
            <span class="picker__name">{{ p.title }}</span>
            <span class="picker__disc mono">{{ p.discipline }}</span>
          </a>
        </li>
        {% endfor %}
      </ol>
    </div>
  </section>

  {# ───────────── CHAPTERS ───────────── #}
  <div class="chapters">
    {% for p in projects %}
    {% set scope = p.aspect != "16/9" %}
        {# Desktop: each chapter is a full-screen project modal opened from the selector.
       Mobile: the wrapper does nothing and the chapter shows inline. #}
    <div class="pmodal" data-pmodal="{{ p.slug }}" aria-label="{{ p.title }}" tabindex="-1">
      <button class="pmodal__close" type="button" data-pmodal-close aria-label="Close project" data-cursor="Close">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
      </button>
    <article class="chapter chapter--{{ 'b' if loop.index is even else 'a' }}{% if scope %} chapter--scope{% endif %}"
             id="{{ p.slug }}" data-chapter data-title="{{ p.title }}" data-no="{{ loop.index | pad }}"
             style="--aspect: {{ p.aspect }}" aria-labelledby="{{ p.slug }}-title">

      <div class="chapter__rule mono" data-reveal>
        <span>Ch. {{ loop.index | pad }}</span>
        <span class="chapter__rule-line" aria-hidden="true"></span>
        <span class="chapter__disc">{{ p.discipline }}</span>
      </div>

      <span class="chapter__num" aria-hidden="true">{{ loop.index | pad }}</span>

      <h3 class="chapter__title" id="{{ p.slug }}-title" data-reveal aria-label="{{ p.title }}">
        {% for l in p.lines %}<span class="mask" aria-hidden="true"><span>{{ l }}</span></span>{% endfor %}
      </h3>

      <figure class="film" data-film data-cursor="{{ 'Sound' if p.hasSound else 'Playing' }}">
        <div class="film__frame">
          <video muted loop playsinline preload="none"
                 poster="/assets/img/{{ p.slug }}-02-1600.jpg"
                 data-src="/assets/video/{{ p.slug }}.mp4"
                 data-src-sm="{% if p.hasSound %}/assets/video/{{ p.slug }}.mp4{% else %}/assets/video/{{ p.slug }}-sm.mp4{% endif %}"
                 aria-label="Film excerpt from {{ p.title }}"></video>
        </div>
        <figcaption class="film__cap mono">
          <span>{{ p.title }}</span><span class="film__tc" data-film-tc>00:00:00</span>
        </figcaption>
        <button class="film__more mono" type="button" data-film-more aria-label="Scroll to the {{ p.title }} story">
          <span>Scroll</span><span class="film__more-line" aria-hidden="true"></span>
        </button>
        {% if p.hasSound %}
        <button class="sound" type="button" aria-pressed="false" data-sound>
          <span class="sound__bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span class="sound__label mono">Sound off</span>
        </button>
        {% endif %}
      </figure>

      <div class="chapter__body" data-reveal>
        <p class="chapter__note mono">{{ p.note }}</p>
        <p class="chapter__desc">{{ p.description }}</p>
      </div>

      {% if p.pullquote %}
      <blockquote class="chapter__pull" data-reveal>
        <p class="serif">{{ p.pullquote }}</p>
      </blockquote>
      {% endif %}

      <ul class="stills" aria-label="Stills from {{ p.title }}">
        {% for s in p.stills %}
        <li class="still still--{{ loop.index }}" data-reveal>
          <button class="still__btn" type="button" data-cursor="View"
                  data-lightbox="{{ p.slug }}" data-index="{{ loop.index0 }}"
                  data-full="/assets/img/{{ s.src }}-2400.jpg" data-caption="{{ p.title }} — still {{ loop.index | pad }}">
            <img src="/assets/img/{{ s.src }}-960.jpg"
                 srcset="/assets/img/{{ s.src }}-960.jpg 960w, /assets/img/{{ s.src }}-1600.jpg 1600w, /assets/img/{{ s.src }}-2400.jpg 2400w"
                 sizes="(max-width: 900px) 100vw, 60vw"
                 alt="{{ s.alt }}" width="1600" height="900" loading="lazy" decoding="async">
          </button>
          <span class="still__no mono">{{ loop.index | pad }} / {{ p.stills.length | pad }}</span>
        </li>
        {% endfor %}
      </ul>
    </article>
          {% set nx = projects[loop.index % projects.length] %}
      <button class="pmodal__next" type="button" data-pmodal-next="{{ nx.slug }}" data-cursor="Next">
        <span class="label mono">Next project <b>—</b> {{ (loop.index % projects.length + 1) | pad }} / {{ projects.length | pad }}</span>
        <span class="pmodal__next-title">{{ nx.title }}</span>
        <span class="pmodal__next-disc mono">{{ nx.discipline }}</span>
      </button>
    </div>
    {% endfor %}
  </div>

  {# ───────────── MARQUEE ───────────── #}
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track" data-marquee>
      {% for i in range(0, 2) %}
      <span class="marquee__group">
        <span>Minds fused</span><b>×</b><span>Stories born</span><b>×</b>
        <span>Minds fused</span><b>×</b><span>Stories born</span><b>×</b>
      </span>
      {% endfor %}
    </div>
  </div>

  {# ───────────── TESTIMONIALS ───────────── #}
  <section class="words" id="words" aria-labelledby="words-title" data-words>
    <div class="words__head">
      <span class="label mono">(Testimonials)</span>
      <h2 class="section-head__title" id="words-title" data-reveal>
        <span class="mask"><span>What they</span></span>
        <span class="mask"><span><em class="serif">said</em></span></span>
      </h2>
      <div class="words__ctrl">
        <button class="arrow" type="button" data-words-prev aria-label="Previous testimonial">
          <svg viewBox="0 0 40 40" width="40" height="40"><path d="M22.5 12.5 15 20l7.5 7.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <span class="words__count mono"><span data-words-now>01</span> / {{ testimonials.length | pad }}</span>
        <button class="arrow" type="button" data-words-next aria-label="Next testimonial">
          <svg viewBox="0 0 40 40" width="40" height="40"><path d="M17.5 12.5 25 20l-7.5 7.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
      <div class="words__progress" aria-hidden="true"><span data-words-bar></span></div>
    </div>

    <div class="words__stage" aria-live="polite">
      {% for t in testimonials %}
      <figure class="quote{% if loop.first %} is-active{% endif %}" data-quote>
        <span class="quote__mark serif" aria-hidden="true">“</span>
        <blockquote><p class="serif">{{ t.quote }}</p></blockquote>
        <figcaption>
          <span class="quote__name">{{ t.name }}</span>
          <span class="quote__role mono">{{ t.role }} <b>—</b> {{ t.company }}</span>
        </figcaption>
      </figure>
      {% endfor %}
    </div>
  </section>

</main>

{# ───────────── CONTACT / FOOTER ───────────── #}
<footer class="contact" id="contact" aria-labelledby="contact-title">
  <div class="contact__top">
    <span class="label mono">(Contact)</span>
    <p class="contact__kicker serif" data-reveal>Minds fused <em>×</em> stories born.</p>
  </div>

  <h2 class="sr-only" id="contact-title">Contact</h2>
  <a class="contact__mail" href="mailto:{{ site.email }}" data-reveal data-cursor="Write">
    <span class="contact__mail-word" data-text="Email us">Email us</span>
    <span class="contact__mail-arrow" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M7 17 17 7M8 7h9v9" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
    </span>
    <span class="contact__mail-addr mono">{{ site.email }}</span>
  </a>

  <div class="contact__base">
    <a class="contact__brand" href="#top" data-link aria-label="{{ site.name }} — back to top">
      <img class="contact__logo" src="/assets/brand/wordmark.png" alt="{{ site.name }}" width="512" height="153" loading="lazy" decoding="async">
    </a>
    <div class="contact__col">
      <h3 class="label mono">Socials</h3>
      {% for s in site.social %}
      <a href="{{ s.url }}" class="link" target="_blank" rel="noopener">{{ s.name }}</a>
      {% endfor %}
    </div>
    <div class="contact__col">
      <h3 class="label mono">Site created by</h3>
      <a href="{{ site.credit.url }}" class="link" target="_blank" rel="noopener">{{ site.credit.name }}</a>
    </div>
  </div>

  <div class="contact__legal mono">
    <span>© {{ "" | year }} {{ site.name }}</span>
    <span class="contact__motto">{{ site.motto }}</span>
    <a href="#top" class="link mono contact__top-link" data-link>Back to top ↑</a>
  </div>
</footer>

{# Stills viewer #}
<dialog class="lightbox" data-lightbox-dialog aria-label="Image viewer">
  <figure class="lightbox__fig">
    <img data-lb-img alt="">
    <figcaption class="mono"><span data-lb-cap></span><span data-lb-count></span></figcaption>
  </figure>
  <button class="lightbox__close mono" type="button" data-lb-close>Close <span aria-hidden="true">×</span></button>
  <button class="arrow lightbox__prev" type="button" data-lb-prev aria-label="Previous image">
    <svg viewBox="0 0 40 40" width="40" height="40"><path d="M22.5 12.5 15 20l7.5 7.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <button class="arrow lightbox__next" type="button" data-lb-next aria-label="Next image">
    <svg viewBox="0 0 40 40" width="40" height="40"><path d="M17.5 12.5 25 20l-7.5 7.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
</dialog>
{% endblock %}
